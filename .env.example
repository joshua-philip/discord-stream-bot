# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
GUILD_ID=your_guild_id

# Role IDs
STREAMING_ROLE_ID=your_streaming_role_id
WHITELISTED_ROLE_ID=your_whitelisted_role_id
PLAYING_ROLE_ID=your_playing_role_id

# Channel IDs
NOTIFICATION_CHANNEL_ID=your_notification_channel_id
LOG_CHANNEL_ID=your_log_channel_id

# API Configuration
PORT=3038
SECRET_KEY=your_secret_key

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/stream

# Admin User IDs (comma separated)
ADMIN_USERS=userid1,userid2,userid3

# Admin Role IDs (comma separated)
ADMIN_ROLES=roleid1,roleid2,roleid3

# PM2 Process Name
PM2_NAME=live-bot